<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\AnvilMap.Abstractions\AnvilMap.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\AnvilMap.Generator\AnvilMap.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <!-- The generator itself now depends on AnvilMap.CodeFixContracts at runtime - an
         OutputItemType="Analyzer" reference only passes the compiler the referenced project's
         own DLL, not its dependencies, so this needs referencing the same way too or the
         generator fails to load with a FileNotFoundException. -->
    <ProjectReference Include="..\..\src\AnvilMap.CodeFixContracts\AnvilMap.CodeFixContracts.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="$(CompilerGeneratedFilesOutputPath)/**/*.cs" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

</Project>
