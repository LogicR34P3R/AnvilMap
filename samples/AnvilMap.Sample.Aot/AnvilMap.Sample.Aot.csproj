<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deliberately EF-Core-free (unlike AnvilMap.Sample), so PublishAot verifies this
       generator's own AOT-friendliness without EF Core's separate AOT story muddying the signal.
       See README.md's "Native AOT" section. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AnvilMap.Abstractions\AnvilMap.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\AnvilMap.Generator\AnvilMap.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
