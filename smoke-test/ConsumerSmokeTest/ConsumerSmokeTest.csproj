<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deliberately outside GeneratedMapper.sln: this project exists to consume the packed
       GeneratedMapper NuGet packages from a local feed (nuget.config, next to this file) exactly
       the way a real external consumer would, via a plain `<PackageReference>` - never as a
       ProjectReference/analyzer wired in directly like the rest of this repo does. See
       .github/workflows/ci.yml's "Smoke-test packages" step. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GeneratedMapper.Generator" Version="0.1.0" />
  </ItemGroup>

</Project>
