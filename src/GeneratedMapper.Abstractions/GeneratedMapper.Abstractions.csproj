<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <IsPackable>true</IsPackable>
    <PackageId>GeneratedMapper.Abstractions</PackageId>
    <Description>Attributes ([MapTo], [MapProperty], [MapIgnore], [MapCondition], [MapUsing], [MapDefault]) and the IMapper interface consumed by GeneratedMapper-generated code. Reference this package directly only if you need the attribute/IMapper types without the source generator itself (e.g. a shared contracts assembly); most consumers should reference GeneratedMapper.Generator instead, which pulls this in automatically.</Description>
    <PackageTags>mapping;object-mapping;source-generator;dto;mapper</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    Opts into the trimmer/AOT analyzer's own build-time warnings - the cheapest way to catch a
    real Native AOT problem before a consumer does. Only meaningful for a runtime-targeting TFM;
    netstandard2.0 has no trimmer/AOT analyzer to run in the first place, so it's scoped to net8.0
    rather than set unconditionally. See docs/roadmapv3.md F15 and README.md's AOT section for the
    actual publish-and-run verification this enables.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
</Project>
