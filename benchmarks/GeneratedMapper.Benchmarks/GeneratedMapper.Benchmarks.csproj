<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\GeneratedMapper.Abstractions\GeneratedMapper.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\GeneratedMapper.Generator\GeneratedMapper.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dev-only benchmark dependency, never part of the packable/shipped surface
         (src/GeneratedMapper.Abstractions, src/GeneratedMapper.Generator). Pinned for
         reproducibility; AutoMapper 15+ uses a commercial/OSS dual license (free for
         individuals and organizations under $5M annual revenue). -->
    <PackageReference Include="AutoMapper" Version="16.2.0" />
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Only has net8.0 assets (no netstandard2.0/net6.0 fallback, no dedicated net10.0 build) -
         excluded below for net6.0, where it can't resolve at all; consumed via its net8.0 asset
         under net10.0 (allowed - a newer TargetFramework can reference an older-targeted
         package), which is why ProjectionBenchmarks/BenchmarkDbContext don't need excluding
         there too. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" Condition="'$(TargetFramework)' != 'net6.0'" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="$(CompilerGeneratedFilesOutputPath)/**/*.cs" />
    <!-- All three depend on Microsoft.EntityFrameworkCore.Sqlite, excluded above for net6.0 -
         see that PackageReference's own comment. -->
    <Compile Remove="Db/BenchmarkDbContext.cs" Condition="'$(TargetFramework)' == 'net6.0'" />
    <Compile Remove="Scenarios/ProjectionBenchmarks.cs" Condition="'$(TargetFramework)' == 'net6.0'" />
    <Compile Remove="Scenarios/ProjectionRuntimeComparisonBenchmarks.cs" Condition="'$(TargetFramework)' == 'net6.0'" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net6.0 stands in for netstandard2.0 here: netstandard2.0 itself can't run as an
         executable, and net6.0 is what actually exercises the generator's netstandard2.0-shaped
         fallback branches (no FrozenDictionary) since GeneratedMapper.Abstractions has no
         net6.0-specific target - a net6.0 consumer resolves its netstandard2.0 asset. net10.0
         added to compare against today's net8.0 baseline, including interceptor-based dispatch
         (see Scenarios/FlatRuntimeComparisonBenchmarks.cs's DispatcherClosedGeneric). -->
    <TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
    <!-- References the generator via ProjectReference, not the packed NuGet package, so it
         doesn't get the buildTransitive-injected InterceptorsNamespaces a real consumer gets
         automatically - opts in itself. Harmless to set unconditionally: interceptors are a no-op
         wherever the generator doesn't actually emit any, so net6.0/net8.0 are unaffected. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);GeneratedMapper</InterceptorsNamespaces>
  </PropertyGroup>

</Project>
