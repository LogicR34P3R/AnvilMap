<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A real MSBuild build (not the in-memory GeneratorTestHelper harness used by
         AnvilMap.Generator.Tests), proving interception works end-to-end through the
         actual SDK/Roslyn toolchain and the real InterceptorsNamespaces wiring - net8.0 doubles
         as a real-build control proving nothing is intercepted pre-C#14. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- Same-solution ProjectReference consumer, so it doesn't get the packed
         buildTransitive-injected InterceptorsNamespaces a real external NuGet consumer gets
         automatically - opts in itself, matching benchmarks/AnvilMap.Benchmarks.csproj.
         Harmless to set unconditionally regardless of TargetFramework - the net8.0 leg relies
         on that. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);AnvilMap</InterceptorsNamespaces>

    <!-- $(TargetFramework) kept in the path so this project's own test code can locate the RIGHT
         TFM's generated output on disk without one multi-targeted build overwriting another's. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated\$(TargetFramework)</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AnvilMap.Abstractions\AnvilMap.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\AnvilMap.Generator\AnvilMap.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Generated\**\*.cs" />
  </ItemGroup>

</Project>
